# ==========================================
# USTOZPRO FULLSTACK ENVIRONMENT CONFIG
# ==========================================

# 1. Express Server porti
PORT=5000
NODE_ENV=development

# 2. PostgreSQL Ma'lumotlar bazasi URL manzili
# Masalan (Neon.tech yoki Supabase bepul bazasi):
# DATABASE_URL=postgres://neondb_owner:password@ep-cold-lake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Yoki mahalliy (Local PostgreSQL):
# DATABASE_URL=postgres://postgres:parol@localhost:5432/ustozpro_db
DATABASE_URL=

# 3. Admin kirish ma'lumotlari
ADMIN_USER=admin
ADMIN_PASS=admin123
